# SQLite file (zero setup). For MySQL: mysql://user:pass@localhost:3306/squareit_crm
DATABASE_URL="file:./dev.db"
# Long random string used to sign login sessions. Change this in production!
AUTH_SECRET="change-me-to-a-long-random-string"

# AI assist for quotations (free, open-source models). Pick one:
# 1. Groq free tier, open-weight gpt-oss-120b. Get a free key at https://console.groq.com/keys
# GROQ_API_KEY=""
# 2. Any OpenAI-compatible server, e.g. OpenRouter's free models:
# AI_BASE_URL="https://openrouter.ai/api/v1"
# AI_API_KEY=""
# AI_MODEL="openai/gpt-oss-120b:free"
# 3. Nothing set: uses Ollama on this computer (ollama pull qwen2.5:7b)

# Email for "Forgot password" links (e.g. GoDaddy: smtpout.secureserver.net, port 465).
# Without these, reset requests still show on the Staff page for HR / Super Admin.
# SMTP_HOST=""
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Squareit CRM <crm@squareit.in>"
# Public address used in reset links (defaults to the address the site was opened on)
# APP_URL="https://crm.squareit.in"
# Key for the passwords Super Admin / HR can view (defaults to AUTH_SECRET; changing it hides stored ones)
# PASSWORD_VIEW_KEY=""
