// Squareit CRM — database schema
// Database: PostgreSQL (Prisma Postgres on Vercel). Set DATABASE_URL
// in .env, then run `npm run setup` once to create tables + admin.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Setting {
  key   String @id
  value String
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  permissions String  @default("{}") // JSON: { module: ["view","create","edit","delete"] }
  staff       Staff[]
}

model Staff {
  id         Int       @id @default(autoincrement())
  firstName  String
  lastName   String
  email      String    @unique
  password   String
  /// The current password, AES-256-GCM encrypted (src/lib/passwords.ts) so Super Admin and HR can view it.
  passwordView  String?
  passwordSetAt DateTime?
  phone      String?
  isAdmin    Boolean   @default(false)
  active     Boolean   @default(true)
  roleId     Int?
  role       Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  lastLogin  DateTime?
  createdAt  DateTime  @default(now())

  // HR record (HR portal). Salary is monthly, in the company currency.
  employeeCode   String?
  designation    String?
  joinDate       DateTime? @db.Date
  dob            DateTime? @db.Date
  gender         String?
  address        String?
  emergencyName  String?
  emergencyPhone String?
  bankName       String?
  bankAccount    String?
  bankIfsc       String?
  pan            String?
  monthlySalary  Float     @default(0)

  attendance       Attendance[]   @relation("AttendanceStaff")
  attendanceMarked Attendance[]   @relation("AttendanceMarker")
  leaveRequests    LeaveRequest[] @relation("LeaveStaff")
  leaveReviewed    LeaveRequest[] @relation("LeaveReviewer")
  payslips         Payslip[]

  leads          Lead[]          @relation("LeadAssignee")
  projects       Project[]       @relation("ProjectMembers")
  tasks          Task[]          @relation("TaskAssignees")
  tasksCreated   Task[]          @relation("TaskCreator")
  taskComments   TaskComment[]
  timeEntries    TimeEntry[]
  tickets        Ticket[]        @relation("TicketAssignee")
  ticketReplies  TicketReply[]
  notes          Note[]
  activities     Activity[]
  todos          Todo[]
  followUps      FollowUp[]
  customerPayments CustomerPayment[]
  orgMemberships DepartmentMember[]

  announcementsSent     Announcement[]     @relation("AnnouncementAuthor")
  announcementsReceived Announcement[]     @relation("AnnouncementRecipients")
  announcementReads     AnnouncementRead[]

  officeExpenses        OfficeExpense[]       @relation("OfficeExpenseCreator")
  officeReportsSent     OfficeExpenseReport[] @relation("OfficeReportSubmitter")
  officeReportsReviewed OfficeExpenseReport[] @relation("OfficeReportReviewer")
  quotations            Quotation[]           @relation("QuotationCreator")
  passwordResets        PasswordReset[]
}

/// "Forgot password" links. Only a SHA-256 of the token is stored.
model PasswordReset {
  id        Int       @id @default(autoincrement())
  staffId   Int
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([staffId])
}

model Customer {
  id        Int       @id @default(autoincrement())
  company   String
  vat       String?
  phone     String?
  website   String?
  address   String?
  city      String?
  state     String?
  zip       String?
  country   String?
  currency  String?
  notes     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  contacts  Contact[]
  invoices  Invoice[]
  estimates Estimate[]
  projects  Project[]
  tasks     Task[]
  tickets   Ticket[]
  expenses  Expense[]
  leads     Lead[]
  quotations Quotation[]
  payments  CustomerPayment[]
}

/** Money received from a customer against a won quotation: an advance, a one-time full payment,
 *  part payments, or the final balance. (Payments against invoices stay in Payment.) */
model CustomerPayment {
  id          Int        @id @default(autoincrement())
  customerId  Int
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotationId Int?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  type        String     @default("ADVANCE") // ADVANCE FULL PART BALANCE
  amount      Float
  mode        String?
  date        DateTime
  reference   String?
  note        String?
  staffId     Int?
  staff       Staff?     @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([customerId])
}

model Contact {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String
  phone      String?
  title      String?
  isPrimary  Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  tickets    Ticket[]
}

model LeadStatus {
  id        Int     @id @default(autoincrement())
  name      String
  color     String  @default("#567bbf")
  order     Int     @default(0)
  isDefault Boolean @default(false)
  leads     Lead[]
}

model LeadSource {
  id    Int    @id @default(autoincrement())
  name  String
  leads Lead[]
}

model Lead {
  id          Int         @id @default(autoincrement())
  name        String
  company     String?
  title       String?
  email       String?
  phone       String?
  website     String?
  address     String?
  city        String?
  country     String?
  value       Float       @default(0)
  description String?
  statusId    Int
  status      LeadStatus  @relation(fields: [statusId], references: [id])
  sourceId    Int?
  source      LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  assignedId  Int?
  assigned    Staff?      @relation("LeadAssignee", fields: [assignedId], references: [id], onDelete: SetNull)
  customerId  Int?        // set once converted
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lost        Boolean     @default(false)
  junk        Boolean     @default(false)
  lastContact DateTime?
  temperature  String?    // HOT | COLD, set after follow-up (junk uses the junk flag)
  nextFollowUp DateTime?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  quotations  Quotation[]
  followUps   FollowUp[]
}

/** One follow-up with a lead after the quotation: a call, WhatsApp, email or meeting. */
model FollowUp {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staffId   Int?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  channel   String   @default("CALL") // CALL WHATSAPP EMAIL MEETING
  note      String?
  outcome   String?  // HOT COLD JUNK, or null when still undecided
  nextDate  DateTime?
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Note {
  id        Int      @id @default(autoincrement())
  relType   String   // lead | customer | project ...
  relId     Int
  content   String
  staffId   Int?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([relType, relId])
}

model Activity {
  id          Int      @id @default(autoincrement())
  relType     String
  relId       Int
  description String
  staffId     Int?
  staff       Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([relType, relId])
}

model Tax {
  id   Int    @id @default(autoincrement())
  name String
  rate Float
}

model Item {
  id              Int     @id @default(autoincrement())
  description     String
  longDescription String?
  rate            Float
  unit            String?
  taxRate         Float   @default(0)
}

model PaymentMode {
  id     Int     @id @default(autoincrement())
  name   String
  active Boolean @default(true)
}

model Invoice {
  id              Int        @id @default(autoincrement())
  number          Int
  prefix          String     @default("INV-")
  customerId      Int
  customer        Customer   @relation(fields: [customerId], references: [id])
  projectId       Int?
  project         Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  date            DateTime
  dueDate         DateTime?
  status          String     @default("DRAFT") // DRAFT UNPAID PARTIAL PAID CANCELLED
  currency        String     @default("INR")
  subtotal        Float      @default(0)
  discountPercent Float      @default(0)
  discountTotal   Float      @default(0)
  taxTotal        Float      @default(0)
  adjustment      Float      @default(0)
  total           Float      @default(0)
  clientNote      String?
  terms           String?
  hash            String     @unique
  sentAt          DateTime?
  createdAt       DateTime   @default(now())
  items           LineItem[]
  payments        Payment[]
  estimate        Estimate?
}

model Estimate {
  id              Int        @id @default(autoincrement())
  number          Int
  prefix          String     @default("EST-")
  customerId      Int
  customer        Customer   @relation(fields: [customerId], references: [id])
  projectId       Int?
  project         Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  date            DateTime
  expiryDate      DateTime?
  status          String     @default("DRAFT") // DRAFT SENT ACCEPTED DECLINED
  currency        String     @default("INR")
  subtotal        Float      @default(0)
  discountPercent Float      @default(0)
  discountTotal   Float      @default(0)
  taxTotal        Float      @default(0)
  adjustment      Float      @default(0)
  total           Float      @default(0)
  clientNote      String?
  terms           String?
  hash            String     @unique
  invoiceId       Int?       @unique
  invoice         Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  items           LineItem[]
}

model LineItem {
  id              Int       @id @default(autoincrement())
  invoiceId       Int?
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  estimateId      Int?
  estimate        Estimate? @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  quotationId     Int?
  quotation       Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description     String
  longDescription String?
  qty             Float     @default(1)
  rate            Float     @default(0)
  unit            String?
  taxRate         Float     @default(0)
  sortOrder       Int       @default(0)
  tag             String?   // quotations: short label on the service card, e.g. "DEV"
  note            String?   // quotations: line under the service in the pricing summary, e.g. "Timeline: 10-15 Days"
}

model Payment {
  id            Int      @id @default(autoincrement())
  invoiceId     Int
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  mode          String
  date          DateTime
  transactionId String?
  note          String?
  createdAt     DateTime @default(now())
}

model ExpenseCategory {
  id       Int       @id @default(autoincrement())
  name     String
  expenses Expense[]
}

model Expense {
  id          Int             @id @default(autoincrement())
  name        String
  categoryId  Int
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount      Float
  taxRate     Float           @default(0)
  date        DateTime
  customerId  Int?
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projectId   Int?
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  paymentMode String?
  reference   String?
  note        String?
  billable    Boolean         @default(false)
  createdAt   DateTime        @default(now())
}

model Project {
  id          Int        @id @default(autoincrement())
  name        String
  customerId  Int
  customer    Customer   @relation(fields: [customerId], references: [id])
  status      String     @default("NOT_STARTED") // NOT_STARTED IN_PROGRESS ON_HOLD CANCELLED FINISHED
  billingType String     @default("FIXED")       // FIXED HOURLY
  rate        Float      @default(0)
  startDate   DateTime
  deadline    DateTime?
  description String?
  progress    Int        @default(0)
  createdAt   DateTime   @default(now())
  members     Staff[]    @relation("ProjectMembers")
  tasks       Task[]
  invoices    Invoice[]
  estimates   Estimate[]
  expenses    Expense[]
  tickets     Ticket[]
}

model Task {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  priority    String        @default("MEDIUM")      // LOW MEDIUM HIGH URGENT
  status      String        @default("NOT_STARTED") // NOT_STARTED IN_PROGRESS TESTING AWAITING_FEEDBACK COMPLETE
  startDate   DateTime      @default(now())
  dueDate     DateTime?
  projectId   Int?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customerId  Int?
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdById Int?
  createdBy   Staff?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  billable    Boolean       @default(false)
  completedAt DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  assignees   Staff[]       @relation("TaskAssignees")
  comments    TaskComment[]
  timeEntries TimeEntry[]
}

model TaskComment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staffId   Int?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  content   String
  createdAt DateTime @default(now())
}

model TimeEntry {
  id        Int       @id @default(autoincrement())
  taskId    Int
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staffId   Int
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime?
  note      String?
}

model Department {
  id      Int      @id @default(autoincrement())
  name    String
  email   String?
  tickets Ticket[]
}

model Ticket {
  id           Int           @id @default(autoincrement())
  subject      String
  message      String
  customerId   Int?
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contactId    Int?
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  name         String?       // for non-contact submitters
  email        String?
  departmentId Int?
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectId    Int?
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  priority     String        @default("MEDIUM") // LOW MEDIUM HIGH URGENT
  status       String        @default("OPEN")   // OPEN IN_PROGRESS ANSWERED ON_HOLD CLOSED
  assignedId   Int?
  assigned     Staff?        @relation("TicketAssignee", fields: [assignedId], references: [id], onDelete: SetNull)
  lastReply    DateTime?
  createdAt    DateTime      @default(now())
  replies      TicketReply[]
}

model TicketReply {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staffId   Int?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  fromName  String?
  message   String
  createdAt DateTime @default(now())
}

model Todo {
  id        Int      @id @default(autoincrement())
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Organisation hierarchy ─────────────────────────────────────────────
// Company departments (HR, BDE, SEO, Paid Advertising > SMM/SEM ...).
// Separate from `Department` above, which only routes support tickets.
model OrgDepartment {
  id        Int                @id @default(autoincrement())
  code      String             @unique // stable key used in code, e.g. "SEO", "SMM"
  name      String
  parentId  Int?
  parent    OrgDepartment?     @relation("OrgDepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  OrgDepartment[]    @relation("OrgDepartmentTree")
  sortOrder Int                @default(0)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  members   DepartmentMember[]
  announcements Announcement[] @relation("AnnouncementDepartments")
}

// A staff member's place in a department and their team role there.
// One row per (staff, department). The schema allows several rows per
// person so "can a user be in more than one department?" can be answered
// later without another migration; the UI currently assigns one.
model DepartmentMember {
  id           Int           @id @default(autoincrement())
  staffId      Int
  staff        Staff         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  departmentId Int
  department   OrgDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  teamRole     String        // TL | EXECUTIVE
  createdAt    DateTime      @default(now())

  @@unique([staffId, departmentId])
  @@index([departmentId])
}

// ─── Announcements ──────────────────────────────────────────────────────
// Sent by a Super Admin to everyone, to departments (a parent department
// includes its sub-departments) or to specific people.
model Announcement {
  id          Int                @id @default(autoincrement())
  title       String
  message     String
  audience    String             // ALL | DEPARTMENTS | PEOPLE
  urgent      Boolean            @default(false)
  pinned      Boolean            @default(false)
  expiresAt   DateTime?
  createdById Int?
  createdBy   Staff?             @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  departments OrgDepartment[]    @relation("AnnouncementDepartments")
  recipients  Staff[]            @relation("AnnouncementRecipients")
  reads       AnnouncementRead[]

  @@index([createdAt])
}

// One row when a person has read (acknowledged) an announcement.
model AnnouncementRead {
  announcementId Int
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  staffId        Int
  staff          Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([announcementId, staffId])
  @@index([staffId])
}

// ─── Office expenses (recorded by HR) ───────────────────────────────────
// Running costs of the office itself: rent, electricity, pantry, stationery…
// Separate from `Expense`, which is spend against customers / projects.
model OfficeExpense {
  id          Int      @id @default(autoincrement())
  title       String
  category    String   // key from OFFICE_EXPENSE_CATEGORIES (src/lib/office-expenses.ts)
  amount      Float
  date        DateTime
  paidTo      String?  // vendor / shop / person
  paymentMode String?
  reference   String?  // bill / receipt number
  note        String?
  createdById Int?
  createdBy   Staff?   @relation("OfficeExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

// One per month: HR submits the month's office expenses to the Super Admin,
// who approves it or sends it back. While SUBMITTED or APPROVED the month is
// locked for HR; RETURNED unlocks it so HR can fix and resubmit.
model OfficeExpenseReport {
  id            Int       @id @default(autoincrement())
  month         String    @unique // "2026-11"
  status        String    // SUBMITTED | APPROVED | RETURNED
  total         Float     // snapshot at submission
  count         Int
  note          String?   // HR's note to the Super Admin
  submittedById Int?
  submittedBy   Staff?    @relation("OfficeReportSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime  @default(now())
  reviewedById  Int?
  reviewedBy    Staff?    @relation("OfficeReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewNote    String?
}

// ─── Quotations (made by BDE) ───────────────────────────────────────────
// A priced proposal for a lead (prospect) or an existing customer. The
// recipient's details are copied in when it's made, so the quotation stays
// the same even if the lead or customer is edited later. Line items reuse
// LineItem (quotationId). Downloadable as PDF: /admin/quotations/[id]/pdf
model Quotation {
  id              Int        @id @default(autoincrement())
  number          Int
  prefix          String     @default("QT-")
  subject         String     // "Quotation for", e.g. "Website Development"
  subtitle        String?    // line under it, e.g. "Doctor / clinic website"
  leadId          Int?
  lead            Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId      Int?
  customer        Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  clientName      String     // person the quotation is addressed to
  clientCompany   String?
  clientEmail     String?
  clientPhone     String?
  clientAddress   String?
  date            DateTime
  validUntil      DateTime?
  status          String     @default("DRAFT") // DRAFT SENT ACCEPTED DECLINED
  currency        String     @default("INR")
  subtotal        Float      @default(0)
  discountPercent Float      @default(0)
  discountTotal   Float      @default(0)
  taxTotal        Float      @default(0)
  adjustment      Float      @default(0)
  total           Float      @default(0)
  intro           String?    // "Engagement overview" paragraph
  scopeIntro      String?    // "Scope of work" opening paragraph
  scope           Json?      // [{ title, body }]: numbered scope sections (body uses simple line markup)
  steps           Json?      // [{ title, text }]: "Acceptance & next steps"
  terms           String?    // one term per line, "Label: text"
  closing         String?    // closing line, e.g. "Thank you for the opportunity..."
  createdById     Int?
  createdBy       Staff?     @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  items           LineItem[]
  payments        CustomerPayment[]

  @@index([leadId])
  @@index([customerId])
}

/** One row per person per day. Made by checking in, by HR marking it, or by an approved leave. */
model Attendance {
  id         Int       @id @default(autoincrement())
  staffId    Int
  staff      Staff     @relation("AttendanceStaff", fields: [staffId], references: [id], onDelete: Cascade)
  date       DateTime  @db.Date
  status     String    @default("PRESENT") // PRESENT ABSENT HALF_DAY LEAVE WFH
  checkIn    DateTime?
  checkOut   DateTime?
  note       String?
  markedById Int?
  markedBy   Staff?    @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([staffId, date])
  @@index([date])
}

model LeaveRequest {
  id           Int       @id @default(autoincrement())
  staffId      Int
  staff        Staff     @relation("LeaveStaff", fields: [staffId], references: [id], onDelete: Cascade)
  type         String    // CASUAL SICK EARNED UNPAID
  fromDate     DateTime  @db.Date
  toDate       DateTime  @db.Date
  halfDay      Boolean   @default(false)
  days         Float
  reason       String?
  status       String    @default("PENDING") // PENDING APPROVED REJECTED CANCELLED
  reviewedById Int?
  reviewedBy   Staff?    @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([staffId, status])
}

model Holiday {
  id   Int      @id @default(autoincrement())
  date DateTime @unique @db.Date
  name String
}

/** Monthly salary slip. Worked out from salary + attendance; HR can add bonus / deductions, then marks it paid. */
model Payslip {
  id          Int       @id @default(autoincrement())
  staffId     Int
  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month       String    // YYYY-MM
  salary      Float
  workingDays Int
  lopDays     Float     @default(0) // loss-of-pay days: absent, unpaid leave, half days
  lopAmount   Float     @default(0)
  bonus       Float     @default(0)
  deduction   Float     @default(0)
  net         Float
  note        String?
  status      String    @default("DRAFT") // DRAFT PAID
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([staffId, month])
}

// ─── Tax invoices (GST) ──────────────────────────────────────────────────
// Standalone GST tax invoice whose PDF replicates src/pdfinvoice exactly.
// PDF: /admin/tax-invoices/[id]/pdf. Items are stored as JSON (TaxInvoiceItem[] in src/lib/tax-invoice.ts).
model TaxInvoice {
  id            Int      @id @default(autoincrement())
  number        String   @unique // e.g. "SS/26-27/070"
  seq           Int      // running number inside the financial year (the 070)
  fy            String   // "26-27"
  customerId    Int?     // optional: customer the details were filled from
  issueDate     DateTime
  dueDate       DateTime?
  billName      String
  billAddress   String?
  billGstin     String?
  shipName      String?
  shipAddress   String?
  placeOfSupply String
  items         Json
  subtotal      Float    @default(0)
  taxTotal      Float    @default(0)
  total         Float    @default(0)
  terms         String?
  declaration   String?
  status        String   @default("UNPAID") // UNPAID PAID CANCELLED
  createdById   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
